venv
build
dist
bisocket.egg-info
.eggs

# Snapshot of the version-bumped files, written by build_helper.py so a
# failed release can be rolled back. Removed on success and on rollback;
# only survives if the release is killed outright.
.release-backup

build.sh
build_helper.py
version.json

__pycache__/
*.pyc
.pytest_cache/

# Generated by Cython / the C compiler. c_main.pyx is regenerated from
# bisocket/main.py by build_helper.py and stays tracked so a plain clone can
# still build the extension.
bisocket/cython/*.c
bisocket/cython/*.so
bisocket/cython/*.pyd

.idea
.DS_Store
